# Copy these into Render Dashboard -> Service -> Environment, or edit render.yaml
# before pushing. Do NOT commit OBF_API_KEY to GitHub.
#
# Render supplies PORT automatically; do not set PORT manually.
# OBF_MAX_IDENTIFY is intentionally omitted: after the revert the identify cap
# is hard-coded to 8 MiB in obf/web.py and does not read an environment variable.

OBF_MAX_SOURCE=10485760
OBF_MAX_BODY=16777216
OBF_TIMEOUT=300
OBF_RATE_LIMIT=24
OBF_ALLOWED_ORIGIN=https://YOUR-SERVICE.onrender.com
OBF_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
